# PotatoCode 配置模板
# 复制为 .potatocode/config.yaml 并填入真实密钥（config.yaml 已被 .gitignore 忽略）。
#
# 字段说明：
#   name      可读名称（显示在底部状态栏左侧）
#   protocol  协议类型：anthropic | openai
#   api_key   API 密钥
#   model     模型名（显示在底部状态栏右侧）
#   base_url  可选，自定义端点（用于接入兼容服务）；缺省用官方默认端点
#   thinking  可选，是否开启扩展思考（仅 anthropic 生效），默认 false
#   context_window  必填，请按实际端点填写上下文窗口（整数，必须大于 33000）
#   max_output_tokens  普通请求输出上限，默认 4096
#   compact_max_output_tokens  摘要输出上限，默认 20000，不能超过 20000
#   openai_output_limit_parameter  OpenAI 兼容端点的输出参数名；默认 max_completion_tokens
#                                  如旧端点要求，可改为 max_tokens

providers:
  - name: Claude
    protocol: anthropic
    api_key: sk-ant-xxx
    model: claude-sonnet-4-5
    thinking: true
    context_window: null  # 填写实际端点窗口后才能发出请求，不根据模型名猜测
    max_output_tokens: 4096
    compact_max_output_tokens: 20000

  # OpenAI 协议示例（按需取消注释）：
  # - name: GPT
  #   protocol: openai
  #   api_key: sk-xxx
  #   model: gpt-4o
  #   context_window: null

  # 兼容端点示例（按需取消注释）：
  # - name: DeepSeek
  #   protocol: openai
  #   api_key: sk-xxx
  #   model: deepseek-chat
  #   base_url: https://api.deepseek.com/v1
  #   context_window: null
