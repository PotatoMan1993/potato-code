# PotatoCode 配置模板
# 复制为 .potatocode/config.yaml 并填入真实密钥（config.yaml 已被 .gitignore 忽略）。
#
# 字段说明：
#   name      可读名称（显示在底部状态栏左侧）
#   protocol  协议类型：anthropic | openai
#   api_key   API 密钥
#   model     模型名（显示在底部状态栏右侧）
#   base_url  可选，自定义端点（用于接入兼容服务）；缺省用官方默认端点
#   thinking  可选，是否开启扩展思考（仅 anthropic 生效），默认 false
#   context_window 单位 token，可选；未配置时按 protocol 默认（anthropic 200000、openai 128000）。
#              它决定自动压缩阈值（context_window − 20000 − 13000）与紧急压缩的判定基准。

providers:
  - name: Claude
    protocol: anthropic
    api_key: sk-ant-xxx
    model: claude-sonnet-4-5
    thinking: true
    context_window: 200000

  # OpenAI 协议示例（按需取消注释）：
  # - name: GPT
  #   protocol: openai
  #   api_key: sk-xxx
  #   model: gpt-4o

  # 兼容端点示例（按需取消注释）：
  # - name: DeepSeek
  #   protocol: openai
  #   api_key: sk-xxx
  #   model: deepseek-chat
  #   base_url: https://api.deepseek.com/v1
