# PotatoCode 配置模板
# 复制为 .potatocode/config.yaml 并填入真实密钥（config.yaml 已被 .gitignore 忽略）。
#
# 字段说明：
#   name      可读名称（显示在底部状态栏左侧）
#   protocol  协议类型：anthropic | openai
#   api_key   API 密钥
#   model     模型名（显示在底部状态栏右侧）
#   base_url  可选，自定义端点（用于接入兼容服务）；缺省用官方默认端点
#   thinking  可选，是否开启扩展思考（仅 anthropic 生效），默认 false
#   context_window 单位 token，可选；未配置时按 protocol 默认（anthropic 200000、openai 128000）。
#              它决定自动压缩阈值（context_window − 20000 − 13000）与紧急压缩的判定基准。
#
# 项目指令文件（POTATOCODE.md，手写 Markdown，不需要在本文件里配置）
#   启动时按以下优先级扫描并拼接，高优先级在前（模型优先遵循），层与层之间空行分隔：
#     ① <项目根>/POTATOCODE.md            项目级，最高优先级
#     ② <项目根>/.potatocode/POTATOCODE.md 项目配置级
#     ③ ~/.potatocode/POTATOCODE.md        用户级，最低优先级
#   文件内可用 `@include <相对路径>`（独占一行）引入其他 Markdown，相对当前文件所在目录解析；
#   嵌套上限 5 层，有环路检测与路径逃逸检测，越界或超深只跳过并在原位留一条注释警告。
#
# 运行时目录（除 sessions 外都不需要手工创建，首次写入时自动建立）
#   .potatocode/sessions/<session_id>/conversation.jsonl  对话存档，每条消息一行 JSON，实时追加
#   .potatocode/sessions/<session_id>/tool-results/       超长工具结果的落盘原文
#   .potatocode/sessions/<session_id>/session.log         该次运行的日志
#   .potatocode/memory/MEMORY.md                          项目级记忆索引（笔记正文为同目录下的 .md）
#   ~/.potatocode/memory/MEMORY.md                        用户级记忆索引
#   /resume 从历史会话列表中恢复；30 天前的会话在启动时由后台任务清理。

providers:
  - name: Claude
    protocol: anthropic
    api_key: sk-ant-xxx
    model: claude-sonnet-4-5
    thinking: true
    context_window: 200000

  # OpenAI 协议示例（按需取消注释）：
  # - name: GPT
  #   protocol: openai
  #   api_key: sk-xxx
  #   model: gpt-4o

  # 兼容端点示例（按需取消注释）：
  # - name: DeepSeek
  #   protocol: openai
  #   api_key: sk-xxx
  #   model: deepseek-chat
  #   base_url: https://api.deepseek.com/v1
